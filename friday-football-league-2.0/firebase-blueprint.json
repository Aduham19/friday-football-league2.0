{
  "entities": {
    "Player": {
      "title": "Player",
      "type": "object",
      "description": "A registered player in the Friday Football League.",
      "properties": {
        "id": { "type": "string", "description": "Unique player identifier" },
        "name": { "type": "string", "description": "Player full name" },
        "avatar": { "type": "string", "description": "Optional avatar URL" },
        "createdAt": { "type": "number", "description": "Timestamp created" }
      },
      "required": ["id", "name"]
    },
    "MatchSheet": {
      "title": "MatchSheet",
      "type": "object",
      "description": "Team match sheet and result summary for a match day.",
      "properties": {
        "teamAName": { "type": "string", "description": "Name of Team A (e.g. Team Gaza)" },
        "teamBName": { "type": "string", "description": "Name of Team B (e.g. Team Rashu)" },
        "teamAScore": { "type": "number", "description": "Goals scored by Team A" },
        "teamBScore": { "type": "number", "description": "Goals scored by Team B" },
        "winner": { "type": "string", "enum": ["teamA", "teamB", "draw", "none"], "description": "Winning team outcome" },
        "playerTeams": { "type": "object", "description": "Player ID to team assignment map" },
        "notes": { "type": "string", "description": "Optional notes or remarks" }
      },
      "required": ["teamAName", "teamBName"]
    },
    "Match": {
      "title": "Match",
      "type": "object",
      "description": "A scheduled or completed league fixture.",
      "properties": {
        "id": { "type": "number", "description": "Match fixture number" },
        "title": { "type": "string", "description": "Match title e.g. Match 1" },
        "date": { "type": "string", "description": "Date in YYYY-MM-DD" },
        "completed": { "type": "boolean", "description": "Whether match is completed" },
        "matchSheet": { "$ref": "#/entities/MatchSheet" }
      },
      "required": ["id", "title", "date", "completed"]
    }
  },
  "firestore": {
    "league/main_season_2026": {
      "entity": "LeagueData",
      "description": "Main document containing league players, matches, matchSheets, results, and deletion tombstones."
    },
    "settings/auth_config": {
      "entity": "AuthConfig",
      "description": "Authentication configuration document."
    }
  }
}
